<?xml version="1.0" encoding="UTF-8"?>
<!-- Hjálparskema fyrir sagnatrog.xsd: hnit úr DataCite kernel-4 (pointLatitude,
     pointLongitude) sem sjálfstæð element. Ekki fullt DataCite-skema. -->
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           targetNamespace="http://datacite.org/schema/kernel-4"
           elementFormDefault="qualified">
  <xs:element name="pointLatitude">
    <xs:simpleType><xs:restriction base="xs:decimal">
      <xs:minInclusive value="-90"/><xs:maxInclusive value="90"/>
    </xs:restriction></xs:simpleType>
  </xs:element>
  <xs:element name="pointLongitude">
    <xs:simpleType><xs:restriction base="xs:decimal">
      <xs:minInclusive value="-180"/><xs:maxInclusive value="180"/>
    </xs:restriction></xs:simpleType>
  </xs:element>
</xs:schema>
