// LISTASAFN_XML_Processes.drl — Listasafn Íslands, sýningar og listamenn (1.10.2026)
// Smíðað 1.10.2026 eftir TIMARIT_XML_Processes.drl og RÚV-reglunum (fólk og hlutverk).
// Reglurnar lesa AFURÐ byggja_listasafn_dc.py (LISTASAFN-tryA.xml).
// Allar forsendur eru af gerð sem ER staðfest í Alma: exist + name()/local-name(),
// @xml:lang og starts-with(text(),'…'). Engin xsi:type-forsenda.
//
// ÓSTAÐFEST í Alma (prófa í fyrsta innlestri):
//   - resourceType "exhibitions" (sérkóði — þarf þýðingu í Facet Resource Type Labels
//     og Icon Codes Labels, eins og places/artifacts 9.9) og "people" (þýtt: Fólk)
//   - "dcterms"."alternative" sem markreitur
// Data Source Code prófílsins: LS_RVK (ákveðið 2.10.2026; Label „Listasafn Íslands“).

rule "listasafn dc:title - copy to title and local1"
when
    exist "//*[local-name()='metadata']/*[name()='oai_dc:dc']/*[name()='dc:title']"
then
    copy "//*[local-name()='metadata']/*[name()='oai_dc:dc']/*[name()='dc:title']" to "dc"."title"
    copy "//*[local-name()='metadata']/*[name()='oai_dc:dc']/*[name()='dc:title']" to "discovery"."local1"
end

rule "listasafn local5 data source"
when
    TRUE
then
    set "LS_RVK" in "discovery"."local5"
end

rule "listasafn external data source flag"
when
    TRUE
then
    set "XDS" in "dcterms"."source"
end

// ---- tegund: Sýning / Event og Einstaklingur / Person ----
rule "listasafn dc:type"
when
    exist "//*[local-name()='metadata']/*[name()='oai_dc:dc']/*[name()='dc:type']"
then
    copy "//*[local-name()='metadata']/*[name()='oai_dc:dc']/*[name()='dc:type']" to "dc"."type"
end

rule "listasafn resourceType and local2"
when
    exist "//*[local-name()='metadata']/*[name()='oai_dc:dc']/*[name()='dc:type'][@xml:lang='en']"
then
    set TEMP"1" to xpath "//*[local-name()='metadata']/*[name()='oai_dc:dc']/*[name()='dc:type'][@xml:lang='en'][1]"
    set TEMP"2" to xpath "//*[local-name()='metadata']/*[name()='oai_dc:dc']/*[name()='dc:type'][@xml:lang='en'][1]"
    replace string by string (TEMP"1","\n","")
    replace string by string (TEMP"2","\n","")
    replace string by string (TEMP"1","\r","")
    replace string by string (TEMP"2","\r","")
    add suffix (TEMP"1","YY")
    add suffix (TEMP"2","YY")
    replace string by string (TEMP"1","^EventYY$","exhibition")
    replace string by string (TEMP"1","^PersonYY$","person")
    replace string by string (TEMP"2","^EventYY$","exhibitions")
    replace string by string (TEMP"2","^PersonYY$","people")
    replace string by string (TEMP"1","^.*YY$","other")
    replace string by string (TEMP"2","^.*YY$","other")
    set TEMP"1" in "discovery"."local2"
    set TEMP"2" in "discovery"."resourceType"
end

// ---- lýsing sýningar eða listamanns ----
rule "listasafn dc:description"
when
    exist "//*[local-name()='metadata']/*[name()='oai_dc:dc']/*[name()='dc:description']"
then
    copy "//*[local-name()='metadata']/*[name()='oai_dc:dc']/*[name()='dc:description']" to "dc"."description"
end

// ---- efnisorð ----
rule "listasafn dc:subject all"
when
    exist "//*[local-name()='metadata']/*[name()='oai_dc:dc']/*[name()='dc:subject']"
then
    copy "//*[local-name()='metadata']/*[name()='oai_dc:dc']/*[name()='dc:subject']" to "dc"."subject"
end

rule "listasafn islensk efnisord to local93"
when
    exist "//*[local-name()='metadata']/*[name()='oai_dc:dc']/*[name()='dc:subject'][@xml:lang='is']"
then
    copy "//*[local-name()='metadata']/*[name()='oai_dc:dc']/*[name()='dc:subject'][@xml:lang='is']" to "discovery"."local93"
end

