// ---- dagsetning: EDTF, sýningartími 2017-04-07/2020-06-07 eða æviár 1876/1958 ----
rule "listasafn dc:date"
when
    exist "//*[local-name()='metadata']/*[name()='oai_dc:dc']/*[name()='dc:date']"
then
    copy "//*[local-name()='metadata']/*[name()='oai_dc:dc']/*[name()='dc:date']" to "dc"."date"
end

// ---- fólk: listamenn sýningar, hlutverk í síuna ----
rule "listasafn dc:creator"
when
    exist "//*[local-name()='metadata']/*[name()='oai_dc:dc']/*[name()='dc:creator']"
then
    copy "//*[local-name()='metadata']/*[name()='oai_dc:dc']/*[name()='dc:creator']" to "dc"."creator"
    copy "//*[local-name()='metadata']/*[name()='oai_dc:dc']/*[name()='dc:creator']" to "discovery"."local49"
end

rule "listasafn hlutverk to local75"
when
    exist "//*[local-name()='metadata']/*[name()='oai_dc:dc']/*[local-name()='bibliographicCitation']"
then
    copy "//*[local-name()='metadata']/*[name()='oai_dc:dc']/*[local-name()='bibliographicCitation']" to "discovery"."local75"
end

// ---- safnið sem staður ----
rule "listasafn safn to coverage"
when
    exist "//*[local-name()='metadata']/*[name()='oai_dc:dc']/*[name()='dc:coverage']"
then
    copy "//*[local-name()='metadata']/*[name()='oai_dc:dc']/*[name()='dc:coverage']" to "dc"."coverage"
    copy "//*[local-name()='metadata']/*[name()='oai_dc:dc']/*[name()='dc:coverage']" to "discovery"."local22"
end

// ---- undirtitill (artist-reitur sem er ekki listamaður) — ÓSTAÐFEST markreitur ----
rule "listasafn dcterms:alternative"
when
    exist "//*[local-name()='metadata']/*[name()='oai_dc:dc']/*[local-name()='alternative']"
then
    copy "//*[local-name()='metadata']/*[name()='oai_dc:dc']/*[local-name()='alternative']" to "dcterms"."alternative"
end

rule "listasafn dc:relation (Sarpur)"
when
    exist "//*[local-name()='metadata']/*[name()='oai_dc:dc']/*[name()='dc:relation']"
then
    copy "//*[local-name()='metadata']/*[name()='oai_dc:dc']/*[name()='dc:relation']" to "dc"."relation"
end

// ---- tenglar: síða á listasafn.is heim; síða + smámynd í dc.identifier (LinkingParameter1/2) ----
rule "listasafn link to resource"
when
    exist "//*[local-name()='metadata']/*[name()='oai_dc:dc']/*[name()='dc:identifier'][starts-with(text(),'https://www.listasafn.is/')]"
then
    copy "//*[local-name()='metadata']/*[name()='oai_dc:dc']/*[name()='dc:identifier'][starts-with(text(),'https://www.listasafn.is/')]" to "dcterms"."source"
end

rule "listasafn identifier url"
when
    exist "//*[local-name()='metadata']/*[name()='oai_dc:dc']/*[name()='dc:identifier'][starts-with(text(),'http')]"
then
    copy "//*[local-name()='metadata']/*[name()='oai_dc:dc']/*[name()='dc:identifier'][starts-with(text(),'http')]" to "dc"."identifier"
end
